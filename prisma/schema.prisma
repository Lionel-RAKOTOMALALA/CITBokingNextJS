generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" // ou "sqlite" selon ton choix
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
  GESTIONNAIRE
}

enum StatutPaiement {
  EN_ATTENTE
  PAYE
  ANNULE
}

enum MoyenPaiement {
  VISA
  CONTACT
  PAYPAL
  AUTRE
}

model Utilisateur {
  id           String       @id @default(uuid())
  nom          String
  email        String       @unique
  motDePasse   String
  role         Role         @default(CLIENT)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  clerkUserId  String?      @unique

  reservations Reservation[]
  paiements    Paiement[]
}

model Hebergement {
  id            String         @id @default(uuid())
  nom           String
  description   String
  localisation  String
  createdAt     DateTime       @default(now())

  chambres      Chambre[]
  videosPrivees VideoPrivee[]
  photos        Photo[]
  typeChambres  TypeChambreHebergement[]
}

model TypeChambre {
  id          String     @id @default(uuid())
  nom         String
  description String
  capaciteMax Int
  chambres    Chambre[]
  hebergements TypeChambreHebergement[]
}

model TypeChambreHebergement {
  id             String      @id @default(uuid())
  hebergementId  String
  typeChambreId  String
  prixParNuit    Float

  hebergement    Hebergement @relation(fields: [hebergementId], references: [id])
  typeChambre    TypeChambre @relation(fields: [typeChambreId], references: [id])
}

model Chambre {
  id             String      @id @default(uuid())
  numero         String
  disponible     Boolean     @default(true)

  hebergementId  String
  typeChambreId  String

  hebergement    Hebergement @relation(fields: [hebergementId], references: [id])
  typeChambre    TypeChambre @relation(fields: [typeChambreId], references: [id])
  reservations   Reservation[]
}

model Reservation {
  id              String      @id @default(uuid())
  dateDebut       DateTime
  dateFin         DateTime
  nombrePersonnes Int
  createdAt       DateTime    @default(now())

  utilisateurId   String
  chambreId       String

  utilisateur     Utilisateur @relation(fields: [utilisateurId], references: [id])
  chambre         Chambre     @relation(fields: [chambreId], references: [id])
  paiement        Paiement?
}

model Paiement {
  id             String          @id @default(uuid())
  montant        Float
  statut         StatutPaiement
  moyenPaiement  MoyenPaiement
  createdAt      DateTime        @default(now())

  utilisateurId  String
  reservationId  String          @unique

  utilisateur    Utilisateur     @relation(fields: [utilisateurId], references: [id])
  reservation    Reservation     @relation(fields: [reservationId], references: [id])
}

model VideoPrivee {
  id            String      @id @default(uuid())
  url           String
  titre         String
  privee        Boolean     @default(true)

  hebergementId String
  hebergement   Hebergement @relation(fields: [hebergementId], references: [id])
  createdAt     DateTime    @default(now())
}

model Photo {
  id            String      @id @default(uuid())
  url           String

  hebergementId String
  hebergement   Hebergement @relation(fields: [hebergementId], references: [id])
  createdAt     DateTime    @default(now())
}

model Voiture {
  id           String   @id @default(uuid())
  marque       String
  modele       String
  prixParJour  Float
  disponible   Boolean  @default(true)
  description  String
  image        String
}

model Activite {
  id              String   @id @default(uuid())
  nom             String
  description     String
  prixParPersonne Float
  localisation    String
  image           String
}